%%BeginSetup
userdict /xerox$jobname <4d6963726f736f667420506f776572506f696e74202d2061736531312d706f73746572205b436f6d7061746962696c697479204d6f64655d> put

featurebegin{
%%BeginFeature: *Duplex One-sided
	<</Duplex false /Tumble false>> xerox$pagedevice copy pop
%%EndFeature
}featurecleanup
<<
     /HWResolution [525 450]
	    >> xerox$pagedevice copy pop

featurebegin{
%%BeginFeature: *XRXJobType normal-print
	userdict /xerox$normal_job_type true put
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *Stapling None
	 << /Staple 0 >> xerox$pagedevice copy pop

%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *Punch None
	<< /Punch false >> xerox$pagedevice copy pop

%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *XRXCoverPageSource Tray1
	userdict /xerox$CoverPageSource 0 put
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *XRXCoverPage None
	
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *XRXSlipSheetSource Tray1
	0 /RRCustomProcs /ProcSet findresource /setslipsheetsource get exec 
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *Slipsheet None
	xerox$pagedevice /SlipSheet 0 put
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *Collation On
	xerox$pagedevice /Collate true put
currentpagedevice /Jog known {xerox$pagedevice /Jog xerox$jog put} if
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *Color Correction 
	xerox$VirtualColorDevice begin /Type 3 def /ColorTransform /Automatic def end
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *Apply to CMYK 
	userdict /xerox$applyToCMYK false put
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *Use Advanced Setup 
	userdict /xerox$useAdvancedSetup false put
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *Use Printer Halftones 
	<</HalftoneMode 1>> setuserparams
%%EndFeature
}featurecleanup

featurebegin{
%%BeginFeature: *sRGBNeutralGray Composite
	  userdict /xerox$grayline /Composite put
 userdict /xerox$VCDOptions <<
 /Grayline /Composite
 >> put

%%EndFeature
}featurecleanup

