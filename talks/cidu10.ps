/CB { { /pp_cy exch def /pp_cx exch def
/pp_cht exch def /pp_cwd exch def }
stopped not { /pp_clip true def } if } def
/B { { /pict_y1 exch def /pict_x1 exch def /pict_y2 exch def /pict_x2 exch def} 
stopped not { /scale_the_picture true def } if } def
