userdict /xerox$NT true put
userdict /xerox$jobpassword <> put
userdict /xerox$jobname <4d6963726f736f667420506f776572506f696e74202d20656d6e6c7030392d636f726566> put
statusdict begin (%%[ ProductName: ) print product print ( ]%%)= flush end
[ 0 1 -1 0 0 0 ] false Pscript_WinNT_Incr dup /initialize get exec
