   userdict /xerox$CoverPageSource 0 put

%%EndFeature
}featurecleanup
featurebegin{
%%BeginFeature: *XRXCoverPage None

%%EndFeature
}featurecleanup
featurebegin{
%%BeginFeature: *XRXImageSmoothing False

   false /RRCustomProcs /ProcSet findresource /setforceinterpolate get exec
